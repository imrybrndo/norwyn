# Supabase (PostgreSQL) — used by Prisma
# DATABASE_URL: pooled connection (PgBouncer, port 6543) for the app runtime.
# DIRECT_URL:   direct connection (port 5432) used by `prisma migrate`.
# Get both from Supabase Dashboard > Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# EVM chain config (Robinhood Chain). Defaults below are best-effort from
# public sources — confirm chain ID / RPC / explorer against Robinhood's own
# developer docs before using in production.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME="Robinhood Chain"
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_CURRENCY_SYMBOL=ETH

# Free project ID from https://cloud.reown.com (formerly WalletConnect Cloud) — required by RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=Your_Reown_Project_Id_Here

# ERC-20 token gating the min-balance-to-play check
NEXT_PUBLIC_TOKEN_CA=Your_Norwyn_Token_Contract_Address_Here
NEXT_PUBLIC_REQUIRED_TOKEN_AMOUNT=400000

# Secret used to sign session JWTs after a Sign-In with Ethereum (SIWE) verification.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=Your_Random_Secret_Here
